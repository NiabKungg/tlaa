# ── Production Environment Variables ──
# เปลี่ยนค่าเหล่านี้เป็นค่าที่คุณต้องการใช้บน Server จริง

# Database
POSTGRES_USER=tlaa_admin
POSTGRES_PASSWORD=generate_a_strong_password_here
POSTGRES_DB=tlaa_prod_db

# Backend
SECRET_KEY=generate_a_very_long_random_string_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# ใส่ IP หรือ Domain ของ Server (เช่น http://185.84.160.153)
CORS_ORIGINS=http://185.84.160.153

# Frontend
# ใส่ IP หรือ Domain ของ Server
NEXT_PUBLIC_API_URL=http://185.84.160.153
INTERNAL_API_URL=http://backend:8000

# Initial Admin
ADMIN_EMAIL=admin@tlaa.or.th
ADMIN_PASSWORD=admin_secure_pass_1234
